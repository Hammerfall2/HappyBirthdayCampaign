@model HappyBirthdayCampain.UI.Models.EmployeeLogin
@{
    ViewBag.Title = "Home Page";
}

<div class="row">
    <div class="col-md-8">
        <section id="loginForm">
            @using (Html.BeginForm("Index", "Home", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
            {
                <h4 style="color:black">Use a local account to log in.</h4>
                <hr />
                @*@Html.ValidationSummary(true, "", new { @class = "text-danger" })*@
                <div class="form-group">
                    @Html.LabelFor(m => m.UserName, new { @class = "col-md-2 control-label" })

                    <div class="col-md-6">

                        @Html.TextBoxFor(m => m.UserName, new { @class = "form-control" })
                        @*@Html.ValidationMessageFor(m => m.UserName, "", new { @class = "text-danger" })*@
                    </div>
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.Password, new { @class = "col-md-2 control-label" })

                    <div class="col-md-6">

                        @* @Html.PasswordFor(m => m.Password, new { @class = "password" })*@
                        <span class="pass" id="test"> @Html.PasswordFor(m => m.Password, new { @class = "form-control", @id = "passwordId", @onchange = "onchangeevent();" }) </span>
                        @*@Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })*@

                    </div>

                </div>
                <div class="form-group">
                    <div class="col-md-offset-2 col-md-10">
                        <input type="submit" value="Log in" class="btn btn-default" />
                    </div>
                </div>
            }
        </section>
    </div>

</div>

@section Scripts
{
    <script type="text/javascript">

        function base64ToBytes(base64) {
            const binString = atob(base64);
            return Uint8Array.from(binString, (m) => m.codePointAt(0));
        }

        function bytesToBase64(bytes) {
            const binString = Array.from(bytes, (byte) =>
                String.fromCodePoint(byte),
            ).join("");
            return btoa(binString);
        }



        function onchangeevent() {
            var purePassword = (document.getElementById('passwordId').value);
            var encode = (bytesToBase64(new TextEncoder().encode(purePassword)));

            //TODO remove
            //  var decode = new TextDecoder().decode(base64ToBytes(encode));
            //    console.log("Encode", encode);
            //    console.log("Decode", decode);

            $('#passwordId').val(encode);
        }

    </script>
}
